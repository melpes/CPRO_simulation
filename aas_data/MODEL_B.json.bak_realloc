     "category": "PARAMETER",
     "idShort": "BOMCategory",
     "description": [
      {
       "language": "en",
       "text": "A collection of inventory policy definitions grouped by part categor. Each sub-collection defines MinStock, MaxStock, and OrderRatio for all parts belonging to that category, enabling category-level replenishment management within the warehouse simulation."
      }
     ],
     "semanticId": {
      "type": "ModelReference",
      "keys": [
       {
        "type": "ConceptDescription",
        "value": "https://www.smart-factory.kr/ids/cd/BOMCategory/1/0"
       }
      ]
     },
     "qualifiers": [
      {
       "kind": "TemplateQualifier",
       "type": "Multiplicity",
       "valueType": "xs:string",
       "value": "One"
      }
     ],
     "value": [
      {
       "category": "PARAMETER",
       "idShort": "RESISTOR",
       "displayName": [
        {
         "language": "en",
         "text": "Resistor"
        }
       ],
       "description": [
        {
         "language": "en",
         "text": "Inventory policy for resistor components. Resistors are SMT-mounted passive components supplied in reels. Replenishment is triggered when stock falls below MinStock."
        }
       ],
       "semanticId": {
        "type": "ModelReference",
        "keys": [
         {
          "type": "ConceptDescription",
          "value": "https://www.smart-factory.kr/ids/cd/RESISTOR/1/0"
