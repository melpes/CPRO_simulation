         ],
         "valueType": "xs:int",
         "value": "500",
         "modelType": "Property"
        },
        {
         "category": "PARAMETER",
         "idShort": "MaxStock",
         "description": [
          {
           "language": "en",
           "text": "Maximum stock quantity for RESISTOR components up to which inventory is replenished when an order is placed. "
          }
         ],
         "semanticId": {
          "type": "ModelReference",
          "keys": [
           {
            "type": "ConceptDescription",
            "value": "https://www.smart-factory.kr/ids/cd/MaxStock/1/0"
