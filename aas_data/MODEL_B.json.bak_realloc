         "value": "One"
        }
       ],
       "value": [
        {
         "category": "PARAMETER",
         "idShort": "MinStock",
         "description": [
          {
           "language": "en",
           "text": "Minimum stock quantity for RESISTOR components below which a replenishment order is placed."
          }
         ],
         "semanticId": {
          "type": "ModelReference",
          "keys": [
           {
            "type": "ConceptDescription",
            "value": "https://www.smart-factory.kr/ids/cd/MinStock/1/0"
